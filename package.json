{
	"private": true,
	"devDependencies": {
		"@wordpress/eslint-plugin": "^25.10.0",
		"@wordpress/stylelint-config": "^24.3.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6"
	},
	"scripts": {
		"cs": "npm run csCSS && npm run csJS",
		"csCSS": "npx stylelint css/style.css",
		"csJS": "npx eslint js/functions.js eslint.config.mjs",
		"csfix": "npm run csfixCSS && npm run csfixJS",
		"csfixCSS": "npx stylelint css/style.css --fix",
		"csfixJS": "npx eslint js/functions.js eslint.config.mjs --fix"
	},
	"allowScripts": {
		"core-js": false,
		"unrs-resolver": false
	},
	"stylelint": {
		"extends": "@wordpress/stylelint-config",
		"rules": {
			"font-weight-notation": "named-where-possible"
		}
	}
}
